# Copie este arquivo e mude o nome para ".env" e preencha com os valores do seu ambiente.

# Porta em que a API vai escutar
PORT=5000

# Origem permitida pelo CORS (endereco do frontend em desenvolvimento)
CORS_ORIGIN=http://localhost:3000

# Chave secreta usada para assinar o JWT de acesso. Use uma string longa e
# aleatoria em producao.
CHAVE_ACESSO=yourpass

# Nome do cookie httpOnly que guarda o token de acesso
COOKIE_NOME=faxina_token

# Conexao com o PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USUARIO=postgres
DB_SENHA=yourpass
DB_NOME=faxina_db
